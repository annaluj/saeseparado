# Configurações de segurança do site SAE

# Não mostra a lista de arquivos das pastas
Options -Indexes

# Bloqueia acesso a arquivos do git e arquivos ocultos (.git, .htaccess, .gitignore...)
RedirectMatch 404 /\.(git|htaccess|gitignore)

# Bloqueia acesso direto aos arquivos de configuração e de funções do PHP
<FilesMatch "^(config|config\.exemplo|conexao|seguranca|usuarios)\.php$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    # Impede que o site seja aberto dentro de um <iframe> de outro site (clickjacking)
    Header always set X-Frame-Options "SAMEORIGIN"
    # Impede o navegador de "adivinhar" o tipo de arquivo
    Header always set X-Content-Type-Options "nosniff"
    # Não envia o endereço completo da página para outros sites
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Não mostra a versão do PHP nas respostas
    Header always unset X-Powered-By
    Header unset X-Powered-By
    # Só permite scripts, estilos e imagens do próprio site (e as fontes do Google).
    # Se um dia precisar de script ou estilo de outro site, adicione o endereço aqui.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>
